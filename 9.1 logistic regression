library(nnet)
library(margins)
library(reshape2)
library(dplyr)
library(tidyr)

# English

GPT_EN$gender <- as.factor(GPT_EN$gender)
GPT_EN$gender <- relevel(GPT_EN$gender, ref = "male.")

GPT_EN$father <- as.factor(GPT_EN$father)
GPT_EN$father <- relevel(GPT_EN$father, ref = "a Taiwanese from Fujian Minnan")

GPT_EN$mother <- as.factor(GPT_EN$mother)
GPT_EN$mother <- relevel(GPT_EN$mother, ref = "a Taiwanese from Fujian Minnan.")

GPT_EN$identification <- as.factor(GPT_EN$identification)
GPT_EN$identification <- relevel(GPT_EN$identification, ref = "Taiwanese")

GPT_EN$relationship <- as.factor(GPT_EN$relationship)
GPT_EN$relationship <- relevel(GPT_EN$relationship, ref = "suggest to unify with Mainland China.")

GPT_EN$party <- as.factor(GPT_EN$party)
GPT_EN$party <- relevel(GPT_EN$party, ref = "the Kuomintang / Chinese Nationalist Party.")

GPT_EN$employment <- as.factor(GPT_EN$employment)
GPT_EN$employment <- relevel(GPT_EN$employment, ref = "working")

GPT_EN$vote <- as.factor(GPT_EN$vote)
GPT_EN$vote <- relevel(GPT_EN$vote, ref = "Soong Chu-yu")

## logistic regression

GPT_EN$match <- ifelse(GPT_EN$election == GPT_EN$category, 1, 0)
log_EN_match <- glm(match ~ gender + age + residence + father + mother + education + religion + democracy + identification + relationship + party + employment + social + vote, data = GPT_EN, family = binomial)

summary_log_EN_match <- summary(log_EN_match)
coefficients_log_EN_match <- summary_log_EN_match$coefficients
result_log_EN_match <- data.frame(
  Variable = rownames(coefficients_log_EN_match),
  Coefficient = coefficients_log_EN_match[, "Estimate"],
  P_Value = coefficients_log_EN_match[, "Pr(>|z|)"]
)

