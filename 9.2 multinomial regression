library(nnet)
library(openxlsx)

# TSCS

## Soong

GPT_EN$election1 <- ifelse(GPT_EN$election == 1, 1, 0)
multi_EN_election_1 <- multinom(election1 ~ gender + age + residence + father + mother + education + religion + democracy + identification + relationship + party + employment + social + vote, data = GPT_EN)
coefficients_multi_EN_election_1 <- summary(multi_EN_election_1)$coefficients
variable_names <- multi_EN_election_1[["coefnames"]]

summary_multi_EN_election_1 <- summary(multi_EN_election_1)
z_values_EN_election_1 <- summary_multi_EN_election_1$coefficients / summary_multi_EN_election_1$standard.errors
p_values_EN_election_1 <- 2 * (1 - pnorm(abs(z_values_EN_election_1)))
print(p_values_EN_election_1)

## Han

GPT_EN$election2 <- ifelse(GPT_EN$election == 2, 1, 0)
