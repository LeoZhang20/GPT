summary_multi_EN_election_2 <- summary(multi_EN_election_2)
z_values_EN_election_2 <- summary_multi_EN_election_2$coefficients / summary_multi_EN_election_2$standard.errors
p_values_EN_election_2 <- 2 * (1 - pnorm(abs(z_values_EN_election_2)))
