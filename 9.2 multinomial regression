## result

result_TSCS_gpt <- data.frame(
  Variable = variable_names,
  Coefficient_Soong = coefficients_multi_EN_election_1,
  Coefficient_Han = coefficients_multi_EN_election_2,
  Coefficient_Tsai = coefficients_multi_EN_election_3
)

